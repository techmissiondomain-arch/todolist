# ======================================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file (it is in .gitignore).
# ======================================================================

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Maps (for the location picker map) ---
# Get one at https://console.cloud.google.com (enable "Maps SDK for Android/iOS")
GOOGLE_MAPS_API_KEY=your-google-maps-key

# --- AI endpoint ---
# This is your deployed Supabase Edge Function URL that talks to Claude.
# The Claude API key lives ON THE SERVER (the edge function), never in the app.
AI_PARSE_URL=https://YOUR-PROJECT-ref.supabase.co/functions/v1/parse-task
